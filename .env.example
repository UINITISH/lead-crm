# ---------------------------------------------------------------------------
# Core Value Realty — Phase 1 environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# 3000 is Moonwalk website, 3100 is Sales to Growth Media. 3400 is this.
# Change it here if it ever clashes with something else.
PORT=3400
NODE_ENV=development

# --- Database --------------------------------------------------------------
# DEFAULT (local dev): DATABASE_URL stays empty, so the app uses PGlite —
# Postgres compiled to WASM. Same SQL, nothing to install, no server to run.
DATABASE_URL=
PGLITE_DIR=./.pgdata

# PRODUCTION: uncomment and point at the real database. The moment this has a
# value, PGlite is bypassed entirely.
# DATABASE_URL=postgres://crm:changeme@localhost:5432/core_realty_crm

# NOTE: dotenv resolves a repeated key to the LAST occurrence in this file.
# Don't append overrides at the bottom expecting the top value to win — edit
# the value in place instead.

# --- Website form ingestion -------------------------------------------------
# Shared secret. The website form's server-side handler signs the payload with
# HMAC-SHA256 and sends it as X-CRM-Signature. Do NOT put this in browser JS.
WEBSITE_INGEST_SECRET=replace-with-32-byte-random-hex
# Comma-separated origins allowed to POST leads (browser-direct fallback only).
ALLOWED_ORIGINS=https://corerealty.example,https://www.corerealty.example

# --- Meta Lead Ads ----------------------------------------------------------
# Set in the Meta App dashboard when subscribing to the leadgen webhook.
META_VERIFY_TOKEN=replace-with-random-string
# App Secret, used to validate X-Hub-Signature-256 on every webhook POST.
META_APP_SECRET=
# Long-lived Page access token with: leads_retrieval, pages_show_list,
# pages_read_engagement, pages_manage_ads, ads_management
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Google Ads Lead Form ---------------------------------------------------
# The "Webhook key" you type into the Google Ads lead form asset. Google echoes
# it back in every payload as google_key; we reject anything that doesn't match.
GOOGLE_WEBHOOK_KEY=replace-with-random-string

# --- Admin UI ---------------------------------------------------------------
# Phase 1 uses a single shared bearer token. Phase 2 replaces this with real
# per-user auth. Do not ship Phase 2 without doing that.
ADMIN_TOKEN=replace-with-random-string
