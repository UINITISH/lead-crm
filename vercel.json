{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/f/(.*)", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" }
  ]
}
