{
  "name": "core-value-realty",
  "version": "0.1.0",
  "private": true,
  "description": "Core Value Realty — Phase 1: multi-source lead capture with campaign-level attribution",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "server": "node --watch src/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:server\" \"npm:client\"",
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client",
    "migrate": "node src/migrate.js",
    "seed": "node scripts/seed.js",
    "test:e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
